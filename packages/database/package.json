{
  "name": "@skillprove/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@skillprove/assessment-engine": "workspace:*",
    "@skillprove/shared": "workspace:*"
  },
  "devDependencies": {
    "@skillprove/config": "workspace:*",
    "@skillprove/validation": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
