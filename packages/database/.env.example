# Copy to .env. Read only by the Prisma CLI in this package.
# Never point this file at production. Production migrations run from the deploy pipeline.

# Neon pooled connection (the host contains "-pooler"). End the URL with sslmode=verify-full.
DATABASE_URL=

# Neon direct connection (no "-pooler"). Used for migrations. End the URL with sslmode=verify-full.
DIRECT_URL=
