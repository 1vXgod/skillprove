# Copy to .env.local.

# Neon pooled connection, ending in sslmode=verify-full.
# Without it the API runs, and /health/ready reports 503.
DATABASE_URL=

# Comma-separated exact browser origins. Native apps send no Origin and do not need an entry.
# Also used as Clerk's authorized parties for session tokens.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# From Clerk Dashboard > API keys. Without both, private routes return 503.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Optional. The PEM public key from the same page, to verify tokens with no network call.
CLERK_JWT_KEY=

# From Clerk Dashboard > Webhooks > your endpoint. Without it the webhook returns 503.
CLERK_WEBHOOK_SIGNING_SECRET=

# AI assessment generation. Server-side only: never put these in a NEXT_PUBLIC_ or EXPO_PUBLIC_ variable.
# Without a key, generation answers 503 and creates no job; manual assessments still work.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional, US dollars per million tokens. Unset means cost is not estimated (tokens are still recorded).
GEMINI_INPUT_PRICE_PER_MILLION=
GEMINI_OUTPUT_PRICE_PER_MILLION=
# Optional limits. Defaults: 10 per user and 40 per company per 24 hours, 3 running at once per company,
# 45 s per provider call, 3 provider calls per job, 2 manual retries per job.
GENERATION_PER_USER_PER_DAY=10
GENERATION_PER_COMPANY_PER_DAY=40
GENERATION_MAX_CONCURRENT_PER_COMPANY=3
GENERATION_PROVIDER_TIMEOUT_MS=45000
GENERATION_MAX_PROVIDER_ATTEMPTS=3
GENERATION_MAX_JOB_RETRIES=2
