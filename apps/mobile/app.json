{
  "expo": {
    "name": "SkillProve",
    "slug": "skillprove",
    "scheme": "skillprove",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#222c6e"
    },
    "ios": {
      "bundleIdentifier": "com.skillprove.app"
    },
    "android": {
      "package": "com.skillprove.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#222c6e"
      }
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-web-browser",
      "@clerk/expo",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
