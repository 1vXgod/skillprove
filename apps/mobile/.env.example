# Copy to .env. Public: these values are included in the app bundle. Never put secrets here.

# Leave unset in development to use port 4000 on the computer running Expo.
# Required for production builds.
EXPO_PUBLIC_API_URL=

# From Clerk Dashboard > API keys. Without it, the app shows that sign-in is not configured.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
